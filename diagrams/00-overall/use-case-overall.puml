@startuml use-case-overall
left to right direction
skinparam packageStyle rectangle
title Biểu đồ Phân rã Gói Ca sử dụng Tổng thể (Use Case Package Diagram)

actor "Sinh viên" as Student
actor "Giảng viên" as Instructor
actor "Cán bộ Đào tạo" as AcademicStaff
actor "Cán bộ Khoa/Viện" as FacultyStaff
actor "Cán bộ Tài chính" as FinanceStaff
actor "Quản trị hệ thống" as Admin
actor "Cổng thanh toán" as PaymentGateway <<External>>

package "Phân hệ CUR (Danh mục & Hệ thống)" {
    usecase "UC-CUR-01: Quản lý Khung CTĐT" as UC_CUR_01
    usecase "Tra cứu CTĐT & Học phần" as UC_CUR_02
    usecase "Quản lý Người dùng & Phân quyền" as UC_CUR_03
}

package "Phân hệ SCH (Tổ chức Giảng dạy)" {
    usecase "UC-SCH-01: Mở Lớp HP & Xếp TKB" as UC_SCH_01
    usecase "Phân công Giảng viên Giảng dạy" as UC_SCH_02
    usecase "Tra cứu Thời khóa biểu" as UC_SCH_03
}

package "Phân hệ REG (Đăng ký HP & Học phí)" {
    usecase "UC-REG-01: Đăng ký Học phần" as UC_REG_01
    usecase "Rút/Hủy Học phần Đăng ký" as UC_REG_02
    usecase "Thanh toán Học phí Trực tuyến" as UC_REG_03
    usecase "Quản lý Hóa đơn & Miễn giảm" as UC_REG_04
}

package "Phân hệ GRD (Kết quả Học tập)" {
    usecase "UC-GRD-01: Nhập điểm & Xét học vụ" as UC_GRD_01
    usecase "Xem Điểm & Bảng điểm Cá nhân" as UC_GRD_02
    usecase "Nộp đơn & Xử lý Phúc khảo Điểm" as UC_GRD_03
}

' Liên kết Actors với Use cases
AcademicStaff --> UC_CUR_01
Student --> UC_CUR_02
Admin --> UC_CUR_03

AcademicStaff --> UC_SCH_01
FacultyStaff --> UC_SCH_02
Student --> UC_SCH_03
Instructor --> UC_SCH_03

Student --> UC_REG_01
Student --> UC_REG_02
Student --> UC_REG_03
PaymentGateway --> UC_REG_03
FinanceStaff --> UC_REG_04

Instructor --> UC_GRD_01
AcademicStaff --> UC_GRD_01
Student --> UC_GRD_02
Student --> UC_GRD_03
Instructor --> UC_GRD_03

@enduml

