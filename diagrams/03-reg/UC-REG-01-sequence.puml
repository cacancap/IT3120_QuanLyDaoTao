@startuml UC-REG-01-sequence
autonumber
title Biểu đồ Trình tự: UC-REG-01 - Đăng ký Học phần

actor "Sinh viên" as SV
boundary "RegistrationPage" as UI
control "RegistrationController" as Ctrl
control "RegistrationService" as RegSvc
control "SCH_Service" as SchSvc
control "CUR_Service" as CurSvc
control "GRD_Service" as GrdSvc
entity "RegistrationPeriod" as PeriodEnt
entity "Registration" as RegEnt
entity "Invoice" as InvEnt

SV -> UI : Mở trang Đăng ký học phần (semesterId)
activate UI
UI -> Ctrl : getRegistrationView(studentId, semesterId)
activate Ctrl
Ctrl -> RegSvc : loadOpenSections(semesterId)
activate RegSvc
RegSvc -> PeriodEnt : checkPeriodOpen(semesterId)
PeriodEnt --> RegSvc : status = OPEN (BR-05)
RegSvc -> SchSvc : getOpenSections(semesterId)
SchSvc --> RegSvc : List<ClassSection>
RegSvc --> Ctrl : ViewData
deactivate RegSvc
Ctrl --> UI : Hiển thị danh sách Lớp HP đang mở
deactivate Ctrl

SV -> UI : Chọn Lớp HP và nhấn "Đăng ký" (sectionId)
UI -> Ctrl : registerSection(studentId, semesterId, sectionId)
activate Ctrl
Ctrl -> RegSvc : processRegistration(studentId, semesterId, sectionId)
activate RegSvc

' 1. Lấy thông tin học phần và tiên quyết từ CUR
RegSvc -> CurSvc : getCourseInfo(courseCode)
activate CurSvc
CurSvc --> RegSvc : {credits, prerequisites[]}
deactivate CurSvc

' 2. Kiểm tra điều kiện tiên quyết BR-01 qua GRD
loop Cho từng mã HP tiên quyết trong prerequisites[]
    RegSvc -> GrdSvc : hasPassed(studentId, prereqCode)
    activate GrdSvc
    GrdSvc --> RegSvc : isPassed (Boolean)
    deactivate GrdSvc
end

' 3. Kiểm tra giới hạn tín chỉ theo mức cảnh báo học vụ BR-02 qua GRD
RegSvc -> GrdSvc : getWarningLevel(studentId, semesterId)
activate GrdSvc
GrdSvc --> RegSvc : warningLevel (0..3)
deactivate GrdSvc
RegSvc -> RegSvc : validateCreditLimit(currentCredits + credits, warningLevel)

' 4. Kiểm tra trùng lịch BR-03 và sĩ số BR-04
RegSvc -> RegSvc : checkScheduleConflict(studentId, sectionSchedule)
RegSvc -> RegSvc : checkSectionCapacity(sectionId)

alt Vi phạm bất kỳ quy tắc nào từ BR-01 đến BR-05
    RegSvc --> Ctrl : Error(RuleViolationMessage)
    Ctrl --> UI : Hiển thị thông báo lỗi tương ứng
else Thỏa mãn toàn bộ điều kiện
    RegSvc -> RegEnt : create(studentId, sectionId, REGISTERED)
    activate RegEnt
    RegEnt --> RegSvc : newRegistration
    deactivate RegEnt
    
    RegSvc -> InvEnt : recalculateTuition(studentId, semesterId, credits)
    activate InvEnt
    InvEnt --> RegSvc : updatedInvoice (BR-06)
    deactivate InvEnt
    
    RegSvc --> Ctrl : RegistrationSuccessDTO
    Ctrl --> UI : Thông báo đăng ký thành công & Cập nhật TKB
end

deactivate RegSvc
deactivate Ctrl
deactivate UI
@enduml